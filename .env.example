# Site-level password gate
SITE_PASSWORD=

# Studio auth and encryption root secret
STUDIO_JWT_SECRET=

# Optional signup/login controls
ALLOWED_EMAILS=
PASSWORDLESS_EMAILS=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email delivery for magic links
RESEND_API_KEY=
STUDIO_FROM_EMAIL="Felix Studio <studio@felixpago.com>"

# Seed routes are disabled in production unless explicitly enabled
ALLOW_SEED_ROUTES=false
